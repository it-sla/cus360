POSTGRES_DB=customer360
POSTGRES_USER=customer360
POSTGRES_PASSWORD=customer360_dev_password
DATABASE_URL=postgresql+psycopg://customer360:customer360_dev_password@db:5432/customer360
TEST_DATABASE_URL=postgresql+psycopg://customer360:customer360_dev_password@db:5432/customer360_test
BACKEND_CORS_ORIGINS=http://localhost:5173
# Signs session cookies (auth.py). REQUIRED -- there is no default, and the app fails to
# start without it (fixed 2026-09-10; used to silently fall back to a hardcoded literal
# that was live in every environment that didn't set this). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Base URL used to build links a human clicks (password-setup links). Falls back to the
# first BACKEND_CORS_ORIGINS entry if unset — set this explicitly wherever that fallback
# wouldn't be the actual address an admin/user opens in a browser (e.g. behind a tunnel).
FRONTEND_BASE_URL=
PGADMIN_DEFAULT_EMAIL=admin@customer360.example.com
PGADMIN_DEFAULT_PASSWORD=admin123
VITE_API_URL=http://localhost:8000/api/v1
MAX_COMPANY_IMPORT_MB=25
MAX_DOCUMENT_UPLOAD_MB=25
DOCUMENT_STORAGE_ROOT=/data/company-documents
CRM_SCRAPER_ENABLED=false
CRM_BASE_URL=
CRM_LOGIN_URL=
CRM_EXPORT_MANIFEST_LIST_URL=
CRM_EXPORT_MANIFEST_DETAIL_URL_TEMPLATE=
CRM_IMPORT_MANIFEST_LIST_URL=
CRM_IMPORT_MANIFEST_DETAIL_URL_TEMPLATE=
CRM_PNL_URL=
CRM_UPS_LIST_URL=
CRM_UPS_DETAIL_URL_TEMPLATE=
CRM_ACTIVE_PIPELINE_URL=
CRM_PIPELINE_LOOKAHEAD_DAYS=180
CRM_PIPELINE_LOOKBACK_DAYS=90
CRM_PIPELINE_SCHEDULE_CRON="15 6,12,18 * * *"
CRM_PNL_SCHEDULE_CRON="30 6,12,18 * * *"
CRM_PNL_SCHEDULE_LOOKBACK_DAYS=31
CRM_DAILY_CALL_LOGS_URL=
CRM_DAILY_CALL_LOGS_SCHEDULE_CRON="45 6,12,18 * * *"
CRM_DAILY_CALL_LOGS_SCHEDULE_LOOKBACK_DAYS=7
CRM_USERNAME=
CRM_PASSWORD=
CRM_ALLOWED_HOSTS=
CRM_HEADLESS=true
CRM_REQUEST_DELAY_MS=750
CRM_NAVIGATION_TIMEOUT_MS=30000
CRM_CONNECT_TIMEOUT_MS=10000
CRM_READ_TIMEOUT_MS=30000
CRM_SESSION_STORAGE_PATH=/data/crm-session/storage-state.json
CRM_SNAPSHOT_STORAGE_PATH=/data/crm-snapshots
CRM_SYNC_POLL_SECONDS=10
CRM_SYNC_MAX_CONCURRENCY=1
CRM_SYNC_MAX_ATTEMPTS=5
CRM_SYNC_LEASE_SECONDS=300
CRM_PARSER_VERSION=2.0.0
CRM_RECONCILIATION_WEIGHT_TOLERANCE=0.01
CRM_DEFAULT_LOOKBACK_DAYS=7
# The scheduler compares against the container's OS clock, which runs in UTC — NOT Nepal
# time (NPT, UTC+5:45). This value is 2:00 PM and 8:00 PM NPT, expressed in UTC.
# If you change the intended NPT time, convert it: UTC = NPT - 5:45.
CRM_SCHEDULE_ENABLED=true
CRM_SCHEDULE_CRON="15 8,14 * * *"
CRM_SCHEDULE_OVERLAP_DAYS=14
CRM_RAW_SNAPSHOT_RETENTION_DAYS=30

# Gmail SMTP (app password) email digests for Tier Shipping Gap alerts — see
# docs/customer-segmentation-rules.md. Both TIER_ALERT_EMAIL_ENABLED=true AND a real
# SMTP_USERNAME + SMTP_PASSWORD are required for anything to actually send; any of
# those being unset/false makes it a silent no-op.
# SMTP_PASSWORD must be a Gmail App Password (myaccount.google.com/apppasswords,
# requires 2FA enabled on the account), never the account's real login password.
TIER_ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
TIER_ALERT_EMAIL_SCHEDULE_CRON="0 8 * * *"


